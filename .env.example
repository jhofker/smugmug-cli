# SmugMug API Credentials
# Copy this file to .env and fill in your credentials
# Get these from: https://api.smugmug.com/api/developer/apply

SMUGMUG_API_KEY=your_api_key_here
SMUGMUG_API_SECRET=your_api_secret_here
SMUGMUG_ACCESS_TOKEN=your_access_token_here
SMUGMUG_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Docker: User/Group IDs (match your host user to avoid permission issues)
# Run 'id -u' and 'id -g' to get your values, or leave as defaults (99:100)
PUID=99
PGID=100

# Docker: Paths
PHOTOS_DIR=./photos
CONFIG_DIR=~/.config/smugmug-cli
CACHE_DIR=~/.cache/smugmug-cli
